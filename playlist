<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEONFLOW | Circular Playlist</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --cyan:#00f5ff;
    --pink:#ff00d4;
    --purple:#7c3cff;
    --green:#00ff9d;
    --bg:#03030b;
    --card:rgba(12,12,30,.72);
    --text:#f5f7ff;
    --muted:#858aa8;
}

body{
    font-family:Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */

body::before{
    content:"";
    position:fixed;
    width:600px;
    height:600px;
    background:var(--purple);
    filter:blur(180px);
    opacity:.25;
    top:-250px;
    left:-180px;
    z-index:-5;
}

body::after{
    content:"";
    position:fixed;
    width:600px;
    height:600px;
    background:var(--cyan);
    filter:blur(200px);
    opacity:.18;
    right:-250px;
    bottom:-250px;
    z-index:-5;
}

canvas{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:-4;
}

/* CONTAINER */

.container{
    width:94%;
    max-width:1400px;
    margin:auto;
    padding:25px 0 50px;
}

/* HEADER */

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.logo{
    font-size:30px;
    font-weight:900;
    letter-spacing:3px;
}

.logo span{
    color:var(--cyan);
    text-shadow:0 0 20px var(--cyan);
}

.online{
    border:1px solid rgba(0,245,255,.3);
    padding:9px 16px;
    border-radius:30px;
    color:var(--cyan);
    background:rgba(0,245,255,.05);
    box-shadow:0 0 20px rgba(0,245,255,.1);
    font-size:12px;
}

.dot{
    display:inline-block;
    width:8px;
    height:8px;
    background:var(--green);
    border-radius:50%;
    box-shadow:0 0 12px var(--green);
    margin-right:7px;
}

/* SEARCH */

.search{
    margin-bottom:25px;
    position:relative;
}

.search input{
    width:100%;
    padding:17px 20px 17px 50px;
    border-radius:15px;
    border:1px solid rgba(255,255,255,.1);
    background:rgba(10,10,25,.75);
    color:white;
    outline:none;
    font-size:15px;
    box-shadow:0 0 25px rgba(0,0,0,.3);
}

.search input:focus{
    border-color:var(--cyan);
    box-shadow:0 0 25px rgba(0,245,255,.15);
}

.search-icon{
    position:absolute;
    left:18px;
    top:16px;
    font-size:20px;
}

/* GRID */

.dashboard{
    display:grid;
    grid-template-columns:430px 1fr;
    gap:22px;
}

/* CARDS */

.card{
    background:var(--card);
    border:1px solid rgba(255,255,255,.09);
    border-radius:25px;
    padding:25px;
    backdrop-filter:blur(25px);
    box-shadow:
        0 20px 70px rgba(0,0,0,.4),
        inset 0 0 30px rgba(255,255,255,.015);
}

/* PLAYER */

.player{
    text-align:center;
}

.album{
    width:270px;
    height:270px;
    margin:5px auto 25px;
    border-radius:50%;
    background:
        radial-gradient(circle at center,#111 0 12%,
        transparent 13%),
        repeating-radial-gradient(
            circle,
            #17172d 0 4px,
            #080812 5px 8px
        );
    border:8px solid #111;
    box-shadow:
        0 0 25px var(--cyan),
        0 0 70px rgba(0,245,255,.35);
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
    animation:spin 8s linear infinite;
    animation-play-state:paused;
}

.album.playing{
    animation-play-state:running;
}

.album::before{
    content:"";
    width:55px;
    height:55px;
    background:linear-gradient(
        135deg,
        var(--pink),
        var(--purple),
        var(--cyan)
    );
    border-radius:50%;
    box-shadow:0 0 30px var(--pink);
}

.album::after{
    content:"";
    position:absolute;
    width:15px;
    height:15px;
    background:#03030b;
    border-radius:50%;
}

@keyframes spin{
    to{transform:rotate(360deg);}
}

.now-label{
    color:var(--cyan);
    letter-spacing:4px;
    font-size:11px;
    margin-bottom:10px;
}

#currentSong{
    font-size:27px;
    margin-bottom:7px;
}

#currentArtist{
    color:var(--muted);
}

.wave{
    height:55px;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:4px;
    margin:20px 0;
}

.wave span{
    width:4px;
    height:15px;
    background:linear-gradient(
        var(--cyan),
        var(--pink)
    );
    border-radius:10px;
    animation:wave .8s infinite alternate;
    animation-play-state:paused;
}

.wave.playing span{
    animation-play-state:running;
}

.wave span:nth-child(2){animation-delay:.1s}
.wave span:nth-child(3){animation-delay:.2s}
.wave span:nth-child(4){animation-delay:.3s}
.wave span:nth-child(5){animation-delay:.4s}
.wave span:nth-child(6){animation-delay:.5s}
.wave span:nth-child(7){animation-delay:.6s}
.wave span:nth-child(8){animation-delay:.7s}
.wave span:nth-child(9){animation-delay:.8s}

@keyframes wave{
    to{height:48px;}
}

/* PROGRESS */

.progress-area{
    margin:10px 0;
}

.progress{
    width:100%;
    height:5px;
    background:#202037;
    border-radius:10px;
    cursor:pointer;
    overflow:hidden;
}

.progress-bar{
    width:0%;
    height:100%;
    background:linear-gradient(
        90deg,
        var(--purple),
        var(--cyan),
        var(--pink)
    );
    box-shadow:0 0 12px var(--cyan);
}

.time{
    display:flex;
    justify-content:space-between;
    color:#626783;
    font-size:10px;
    margin-top:7px;
}

/* CONTROLS */

.controls{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    margin-top:20px;
}

.ctrl{
    width:45px;
    height:45px;
    border-radius:50%;
    border:1px solid #292b4b;
    background:#0d0d1c;
    color:white;
    cursor:pointer;
    transition:.25s;
}

.ctrl:hover{
    color:var(--cyan);
    border-color:var(--cyan);
    box-shadow:0 0 20px rgba(0,245,255,.3);
    transform:scale(1.1);
}

.play{
    width:65px;
    height:65px;
    background:linear-gradient(
        135deg,
        var(--purple),
        var(--pink)
    );
    border:none;
    font-size:22px;
    box-shadow:0 0 30px rgba(255,0,212,.3);
}

/* EXTRA CONTROLS */

.extra{
    display:flex;
    justify-content:center;
    gap:20px;
    margin-top:18px;
}

.extra button{
    background:none;
    border:none;
    color:#656985;
    cursor:pointer;
    font-size:17px;
}

.extra button:hover,
.extra button.active{
    color:var(--cyan);
    text-shadow:0 0 15px var(--cyan);
}

/* VOLUME */

.volume{
    display:flex;
    align-items:center;
    gap:10px;
    margin-top:20px;
    color:#777b98;
}

.volume input{
    flex:1;
}

/* PLAYLIST */

.playlist-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.playlist-head h2{
    font-size:23px;
}

.stats{
    display:flex;
    gap:10px;
}

.stat{
    padding:8px 12px;
    background:#101025;
    border:1px solid #20213c;
    border-radius:10px;
    font-size:11px;
    color:var(--muted);
}

.song-list{
    max-height:390px;
    overflow-y:auto;
}

.song-list::-webkit-scrollbar{
    width:5px;
}

.song-list::-webkit-scrollbar-thumb{
    background:#35365a;
    border-radius:20px;
}

.song{
    display:flex;
    align-items:center;
    gap:13px;
    padding:12px;
    margin-bottom:8px;
    border-radius:15px;
    border:1px solid transparent;
    transition:.25s;
}

.song:hover{
    background:rgba(255,255,255,.04);
    border-color:rgba(255,255,255,.08);
    transform:translateX(4px);
}

.song.active{
    background:
        linear-gradient(
            90deg,
            rgba(0,245,255,.09),
            rgba(255,0,212,.04)
        );
    border-color:rgba(0,245,255,.25);
    box-shadow:inset 3px 0 var(--cyan);
}

.number{
    width:25px;
    color:#555978;
    font-size:12px;
}

.cover{
    width:45px;
    height:45px;
    border-radius:11px;
    background:
        linear-gradient(
            135deg,
            var(--purple),
            var(--pink),
            var(--cyan)
        );
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:19px;
}

.info{
    flex:1;
}

.info h3{
    font-size:14px;
    margin-bottom:5px;
}

.info p{
    color:#656983;
    font-size:11px;
}

.actions{
    display:flex;
    gap:5px;
}

.actions button{
    border:none;
    background:none;
    color:#555978;
    cursor:pointer;
    padding:7px;
}

.actions button:hover{
    color:var(--cyan);
}

.favorite{
    color:#ff3d9a !important;
    text-shadow:0 0 10px #ff3d9a;
}

/* ADD */

.add{
    margin-top:20px;
    padding-top:20px;
    border-top:1px solid #1c1d35;
}

.add h3{
    margin-bottom:12px;
}

.inputs{
    display:grid;
    grid-template-columns:1fr 1fr auto;
    gap:8px;
}

.inputs input{
    background:#080817;
    border:1px solid #252642;
    color:white;
    padding:12px;
    border-radius:10px;
    outline:none;
}

.inputs input:focus{
    border-color:var(--cyan);
}

.add-btn{
    border:none;
    border-radius:10px;
    padding:0 18px;
    background:linear-gradient(
        135deg,
        var(--cyan),
        var(--purple)
    );
    color:white;
    font-weight:bold;
    cursor:pointer;
}

/* LINKED LIST */

.link-card{
    margin-top:22px;
}

.link-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.link-title h2{
    font-size:20px;
}

.badge{
    color:var(--green);
    border:1px solid rgba(0,255,157,.3);
    padding:6px 10px;
    border-radius:20px;
    font-size:10px;
}

.nodes{
    min-height:190px;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    overflow-x:auto;
    padding:25px 10px;
}

.node{
    min-width:110px;
    padding:17px 10px;
    text-align:center;
    border-radius:16px;
    background:#09091a;
    border:1px solid #282a4b;
    position:relative;
    transition:.3s;
    box-shadow:0 0 20px rgba(0,0,0,.3);
}

.node:hover{
    border-color:var(--cyan);
    transform:translateY(-7px);
    box-shadow:0 0 25px rgba(0,245,255,.2);
}

.node.active-node{
    border-color:var(--pink);
    box-shadow:
        0 0 20px rgba(255,0,212,.3),
        inset 0 0 20px rgba(255,0,212,.05);
}

.node-icon{
    font-size:23px;
    color:var(--cyan);
    margin-bottom:8px;
}

.node strong{
    display:block;
    font-size:11px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.node small{
    display:block;
    color:#555978;
    margin-top:5px;
    font-size:9px;
}

.arrow{
    color:var(--cyan);
    font-size:23px;
    text-shadow:0 0 10px var(--cyan);
}

.circular-arrow{
    text-align:center;
    color:var(--pink);
    margin-top:-5px;
    font-size:12px;
}

/* TOAST */

.toast{
    position:fixed;
    bottom:25px;
    right:25px;
    padding:14px 20px;
    background:#111126;
    border:1px solid var(--cyan);
    border-radius:12px;
    color:white;
    box-shadow:0 0 30px rgba(0,245,255,.2);
    transform:translateY(100px);
    opacity:0;
    transition:.4s;
    z-index:10;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* RESPONSIVE */

@media(max-width:950px){

    .dashboard{
        grid-template-columns:1fr;
    }

    .inputs{
        grid-template-columns:1fr;
    }

    .add-btn{
        padding:12px;
    }

}

</style>
</head>

<body>

