<script>

/* ========================================
   CIRCULAR LINKED LIST
   ======================================== */

class Node{

    constructor(name,artist){

        this.name=name;
        this.artist=artist;

        this.next=null;

        this.favorite=false;
    }
}


class CircularPlaylist{

    constructor(){

        this.head=null;
        this.current=null;
        this.size=0;

    }


    /* INSERT */

    insert(name,artist){

        let newNode=
            new Node(name,artist);


        if(this.head===null){

            this.head=newNode;

            newNode.next=this.head;

            this.current=this.head;

        }

        else{

            let temp=this.head;


            while(temp.next!==this.head){

                temp=temp.next;

            }


            temp.next=newNode;

            newNode.next=this.head;

        }


        this.size++;

    }


    /* DELETE */

    delete(name){

        if(this.head===null)
            return false;


        let current=this.head;

        let previous=null;


        do{

            if(
                current.name.toLowerCase()
                ===name.toLowerCase()
            ){

                /* ONE NODE */

                if(current.next===current){

                    this.head=null;

                    this.current=null;

                }

                else{

                    /* CURRENT IS HEAD */

                    if(current===this.head){

                        this.head=
                            this.head.next;

                    }


                    if(this.current===current){

                        this.current=
                            current.next;

                    }


                    let last=this.head;


                    while(last.next!==current){

                        last=last.next;

                    }


                    last.next=current.next;

                }


                this.size--;

                return true;

            }


            previous=current;

            current=current.next;


        }while(current!==this.head);


        return false;

    }


    /* UPDATE */

    update(oldName,newName,newArtist){

        if(this.head===null)
            return false;


        let temp=this.head;


        do{

            if(
                temp.name.toLowerCase()
                ===oldName.toLowerCase()
            ){

                temp.name=newName;

                temp.artist=newArtist;

                return true;

            }


            temp=temp.next;


        }while(temp!==this.head);


        return false;

    }


    /* SEARCH */

    search(name){

        if(this.head===null)
            return null;


        let temp=this.head;


        do{

            if(
                temp.name.toLowerCase()
                ===name.toLowerCase()
            ){

                return temp;

            }


            temp=temp.next;


        }while(temp!==this.head);


        return null;

    }


    /* NEXT */

    next(){

        if(this.current!==null){

            this.current=
                this.current.next;

        }

    }


    /* PREVIOUS */

    previous(){

        if(this.current===null)
            return;


        let temp=this.current;


        while(temp.next!==this.current){

            temp=temp.next;

        }


        this.current=temp;

    }


    /* DISPLAY */

    display(){

        let result=[];


        if(this.head===null)
            return result;


        let temp=this.head;


        do{

            result.push(temp);

            temp=temp.next;


        }while(temp!==this.head);


        return result;

    }

}


/* ========================================
   CREATE PLAYLIST
   ======================================== */

let playlist=
    new CircularPlaylist();


/* SAMPLE SONGS */

playlist.insert(
    "Kesariya",
    "Arijit Singh"
);

playlist.insert(
    "Tum Hi Ho",
    "Arijit Singh"
);

playlist.insert(
    "Chaleya",
    "Arijit Singh"
);

playlist.insert(
    "Apna Bana Le",
    "Arijit Singh"
);

playlist.insert(
    "Heeriye",
    "Jasleen Royal"
);

playlist.insert(
    "Aaj Ki Raat",
    "Madhubanti Bagchi"
);


/* ========================================
   PLAY / PAUSE
   ======================================== */

let playing=false;

function togglePlay(){

    if(playlist.current===null){

        toast("Add songs first!");

        return;

    }


    playing=!playing;


    document.getElementById(
        "playButton"
    ).textContent=
        playing ? "❚❚" : "▶";


    document.getElementById(
        "album"
    ).classList.toggle(
        "playing",
        playing
    );


    document.getElementById(
        "wave"
    ).classList.toggle(
        "playing",
        playing
    );


    toast(
        playing
        ? "▶ Playing "+playlist.current.name
        : "⏸ Music paused"
    );

}


/* ========================================
   NEXT
   ======================================== */

function nextSong(){

    playlist.next();

    playing=true;

    updatePlayer();

    toast(
        "Next: "+
        playlist.current.name
    );

}


/* ========================================
   PREVIOUS
   ======================================== */

function previousSong(){

    playlist.previous();

    playing=true;

    updatePlayer();

    toast(
        "Previous: "+
        playlist.current.name
    );

}


/* ========================================
   UPDATE PLAYER
   ======================================== */

function updatePlayer(){

    if(playlist.current===null){

        document.getElementById(
            "currentSong"
        ).textContent="No Song";

        return;

    }


    document.getElementById(
        "currentSong"
    ).textContent=
        playlist.current.name;


    document.getElementById(
        "currentArtist"
    ).textContent=
        playlist.current.artist;


    document.getElementById(
        "playButton"
    ).textContent=
        playing ? "❚❚" : "▶";


    document.getElementById(
        "album"
    ).classList.toggle(
        "playing",
        playing
    );


    document.getElementById(
        "wave"
    ).classList.toggle(
        "playing",
        playing
    );


    displayPlaylist();

}


/* ========================================
   ADD SONG
   ======================================== */

function addSong(){

    let name=
        document
        .getElementById("songName")
        .value.trim();


    let artist=
        document
        .getElementById("artistName")
        .value.trim();


    if(name===""||artist===""){

        toast(
            "⚠ Enter song and artist"
        );

        return;

    }


    playlist.insert(name,artist);


    document
    .getElementById("songName")
    .value="";


    document
    .getElementById("artistName")
    .value="";


    saveData();

    displayPlaylist();

    toast(
        "✓ Song inserted into linked list"
    );

}


/* ========================================
   DELETE
   ======================================== */

function deleteSong(name){

    if(
        playlist.delete(name)
    ){

        saveData();

        displayPlaylist();

        toast(
            "🗑 Song deleted"
        );

    }

}


/* ========================================
   UPDATE
   ======================================== */

function editSong(name){

    let newName=
        prompt(
            "Enter new song name:",
            name
        );


    if(!newName)
        return;


    let newArtist=
        prompt(
            "Enter new artist:"
        );


    if(!newArtist)
        return;


    if(
        playlist.update(
            name,
            newName,
            newArtist
        )
    ){

        saveData();

        displayPlaylist();

        toast(
            "✎ Song updated"
        );

    }

}


/* ========================================
   FAVORITE
   ======================================== */

function favoriteSong(song){

    song.favorite=
        !song.favorite;


    saveData();

    displayPlaylist();

}


/* ========================================
   SEARCH
   ======================================== */

function searchSongs(){

    let query=
        document
        .getElementById("search")
        .value
        .toLowerCase();


    let songs=
        playlist.display();


    let container=
        document
        .getElementById("playlist");


    container.innerHTML="";


    songs.forEach(
        function(song,index){

            if(
                song.name
                .toLowerCase()
                .includes(query)
                ||
                song.artist
                .toLowerCase()
                .includes(query)
            ){

                createSongElement(
                    song,
                    index,
                    container
                );

            }

        }
    );

}


/* ========================================
   DISPLAY PLAYLIST
   ======================================== */

function displayPlaylist(){

    let container=
        document
        .getElementById("playlist");


    container.innerHTML="";


    let songs=
        playlist.display();


    songs.forEach(
        function(song,index){

            createSongElement(
                song,
                index,
                container
            );

        }
    );


    document.getElementById(
        "songCount"
    ).textContent=
        songs.length;


    let favorites=
        songs.filter(
            song=>song.favorite
        ).length;


    document.getElementById(
        "favCount"
    ).textContent=
        favorites;


    displayNodes();

}


/* ========================================
   CREATE SONG UI
   ======================================== */

function createSongElement(
    song,
    index,
    container
){

    let item=
        document.createElement("div");


    item.className="song";


    if(
        song===playlist.current
    ){

        item.classList.add("active");

    }


    item.innerHTML=`

        <div class="number">
            ${String(index+1).padStart(2,"0")}
        </div>

        <div class="cover">
            ♪
        </div>

        <div class="info">

            <h3>
                ${song.name}
            </h3>

            <p>
                ${song.artist}
            </p>

        </div>

        <div class="actions">

            <button
                onclick="playlist.current=
                song;
                playing=true;
                updatePlayer();">

                ▶
            </button>

            <button
                class="${
                    song.favorite
                    ? "favorite"
                    : ""
                }"
                onclick="favoriteSong(song)">

                ♥
            </button>

            <button
                onclick="editSong(
                '${song.name.replace(
                    /'/g,
                    "\\'"
                )}')">

                ✎
            </button>

            <button
                onclick="deleteSong(
                '${song.name.replace(
                    /'/g,
                    "\\'"
                )}')">

                🗑
            </button>

        </div>

    `;


    container.appendChild(item);

}


/* ========================================
   LINKED LIST VISUALIZATION
   ======================================== */

function displayNodes(){

    let container=
        document
        .getElementById("nodes");


    container.innerHTML="";


    let songs=
        playlist.display();


    songs.forEach(
        function(song,index){

            let node=
                document.createElement("div");


            node.className="node";


            if(
                song===playlist.current
            ){

                node.classList.add(
                    "active-node"
                );

            }


            node.innerHTML=`

                <div class="node-icon">
                    ♪
                </div>

                <strong>
                    ${song.name}
                </strong>

                <small>
                    NODE ${index+1}
                </small>

            `;


            container.appendChild(node);


            if(
                index<songs.length-1
            ){

                let arrow=
                    document.createElement(
                        "div"
                    );


                arrow.className="arrow";

                arrow.textContent="→";

                container.appendChild(
                    arrow
                );

            }

        }
    );


    if(songs.length>1){

        let arrow=
            document.createElement(
                "div"
            );


        arrow.className="arrow";

        arrow.textContent="↻";

        container.appendChild(
            arrow
        );

    }

}


/* ========================================
   SHUFFLE
   ======================================== */

let shuffle=false;


function toggleShuffle(){

    shuffle=!shuffle;


    document
    .getElementById("shuffle")
    .classList.toggle(
        "active",
        shuffle
    );


    toast(
        shuffle
        ? "🔀 Shuffle ON"
        : "Shuffle OFF"
    );

}


/* ========================================
   PROGRESS BAR
   ======================================== */

let progress=0;


setInterval(
    function(){

        if(!playing)
            return;


        progress+=.15;


        if(progress>=100){

            progress=0;

            nextSong();

        }


        document
        .getElementById(
            "progressBar"
        )
        .style.width=
            progress+"%";


        let seconds=
            Math.floor(
                progress*2.25
            );


        let min=
            Math.floor(seconds/60);


        let sec=
            seconds%60;


        document
        .getElementById(
            "currentTime"
        )
        .textContent=
            min+":"+
            String(sec).padStart(2,"0");


    },
    1000
);


/* CLICK PROGRESS */

function seek(event){

    let bar=
        event.currentTarget;


    let percent=
        event.offsetX/
        bar.offsetWidth*
        100;


    progress=percent;

}


/* ========================================
   TOAST
   ======================================== */

let toastTimer;


function toast(message){

    let box=
        document
        .getElementById("toast");


    box.textContent=message;

    box.classList.add("show");


    clearTimeout(toastTimer);


    toastTimer=
        setTimeout(
            ()=>{
                box.classList.remove(
                    "show"
                );
            },
            2200
        );

}


/* ========================================
   LOCAL STORAGE
   ======================================== */

function saveData(){

    let songs=
        playlist.display();


    localStorage.setItem(
        "neonflow",
        JSON.stringify(
            songs.map(
                song=>({
                    name:song.name,
                    artist:song.artist,
                    favorite:song.favorite
                })
            )
        )
    );

}


/* ========================================
   PARTICLE BACKGROUND
   ======================================== */

const canvas=
    document.getElementById(
        "particles"
    );

const ctx=
    canvas.getContext("2d");


let particles=[];


function resize(){

    canvas.width=
        window.innerWidth;

    canvas.height=
        window.innerHeight;

}


resize();


window.addEventListener(
    "resize",
    resize
);


for(let i=0;i<80;i++){

    particles.push({

        x:Math.random()*
            window.innerWidth,

        y:Math.random()*
            window.innerHeight,

        size:
            Math.random()*2+1,

        speed:
            Math.random()*.5+.1

    });

}


function animateParticles(){

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    particles.forEach(
        p=>{

            p.y-=p.speed;


            if(p.y<0){

                p.y=
                    canvas.height;

            }


            ctx.beginPath();


            ctx.arc(
                p.x,
                p.y,
                p.size,
                0,
                Math.PI*2
            );


            ctx.fillStyle=
                "rgba(0,245,255,.55)";


            ctx.fill();

        }
    );


    requestAnimationFrame(
        animateParticles
    );

}


animateParticles();


/* ========================================
   START
   ======================================== */

updatePlayer();

</script>

</body>
</html>
